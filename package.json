{
  "name": "laidrivm.com",
  "version": "0.0.1",
  "module": "src/index.ts",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/bun": "^1.2.18",
    "@types/prismjs": "^1.26.5",
    "@types/unidecode": "^1.1.0",
    "esbuild": "^0.25.6",
    "esbuild-css-modules-plugin": "^3.1.5",
    "eslint": "^9.31.0",
    "eslint-plugin-css": "^0.11.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^50.8.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-sonarjs": "^3.0.4",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.36.0"
  },
  "dependencies": {
    "@elysiajs/static": "^1.3.0",
    "@kitajs/html": "^4.2.9",
    "@kitajs/ts-html-plugin": "^4.1.1",
    "buffer": "^6.0.3",
    "elysia": "^1.3.5",
    "marked": "^15.0.12",
    "normalize.css": "^8.0.1",
    "octokit": "^4.1.4",
    "prismjs": "^1.30.0",
    "unidecode": "^1.1.0"
  },
  "scripts": {
    "format": "prettier --write 'src/**/*.{css,html,ts,tsx}'",
    "lint": "eslint 'src/**/*.{css,html,ts,tsx}' --fix",
    "test": "bun test --timeout 1000 --verbose --coverage && xss-scan",
    "server_dev": "bun --env-file=.env.development --watch src/server.ts",
    "dev": "bun format && bun lint && bun server_dev",
    "clean": "bun public-clean-up.ts",
    "prepare": "husky",
    "new_build": "NODE_ENV=production bun new_build.ts",
    "new_prod": "NODE_ENV=production bun --env-file=.env.production out/server.js",
    "build": "NODE_ENV=production bun run build.ts",
    "generate_dev": "bun run --env-file=.env.development src/generate.tsx",
    "old_dev": "bun lint && bun format && bun run build && bun generate_dev && bun run server_dev",
    "old_generate": "bun run out/generate.js",
    "old_server": "bun run out/index.js",
    "prod": "NODE_ENV=production bun run generate && bun run server"
  }
}
